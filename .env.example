# ============================================================
# Front-end KropFeet — variáveis expostas ao browser
# Use SEMPRE a publishable/anon key (nunca a service_role_key).
# ============================================================
VITE_SUPABASE_URL=https://ladpawjpnaydgqremtnu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Chave secreta da SumUp. O Vite lê este valor só no servidor e consulta a API
# em /api/sumup. Não use o prefixo VITE_: a chave não pode ir para o navegador.
# Crie em me.sumup.com → Configurações → Para desenvolvedores → Chaves de API.
SUMUP_API_KEY=
# Opcional. Se vazio, o código da conta é lido em GET /v0.1/me.
# SUMUP_MERCHANT_CODE=
# O proxy local acima atende só a conta de Portugal e é usado enquanto a
# Edge Function "sumup" não estiver publicada.

# ============================================================
# Edge Function "sumup" (supabase/functions/sumup) — NÃO vão neste arquivo.
# Cadastre como secrets do projeto Supabase:
#   npx supabase secrets set --project-ref ladpawjpnaydgqremtnu \
#     SUMUP_PT_API_KEY=sup_sk_... SUMUP_BR_API_KEY=sup_sk_...
# Opcionais: SUMUP_PT_MERCHANT_CODE, SUMUP_BR_MERCHANT_CODE
# ============================================================
